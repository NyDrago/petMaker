<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PetMaker.MainWindow"
        Title="Pet Maker" Width="420" Height="480">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <Button Name="ImportBtn" Content="Create from image…" />
      <Button Name="RunBtn" Content="Run" />
      <Button Name="DeleteBtn" Content="Delete" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Name="Status" Margin="0,10,0,0" Opacity="0.7" />
    <ListBox Name="PetList">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Image Grid.Column="0" Source="{Binding Thumb}" Width="48" Height="48" Stretch="Uniform" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Settings" VerticalAlignment="Center" Click="OnSettingsClick" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
